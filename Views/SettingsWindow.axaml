<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RemotePC.ViewModels"
        x:Class="RemotePC.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Title="RemotePC Settings"
        Width="560"
        Height="620"
        MinWidth="420"
        MinHeight="520"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,12,0,6" />
    </Style>
    <Style Selector="TextBlock.subtle">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="18">
    <StackPanel>
      <TextBlock Text="Settings"
                 FontSize="20"
                 FontWeight="SemiBold" />
      <TextBlock Text="{Binding SettingsPath}"
                 Classes="subtle"
                 Margin="0,4,0,4"
                 TextWrapping="Wrap" />
    </StackPanel>

    <TabControl Grid.Row="1"
                Margin="0,10,0,0">
      <TabItem Header="General">
        <StackPanel Margin="0,8,0,0">
          <CheckBox Content="Start RemotePC with Windows"
                    IsChecked="{Binding StartWithWindows}" />
          <CheckBox Content="Start minimized"
                    IsChecked="{Binding StartMinimized}"
                    Margin="0,8,0,0" />
          <CheckBox Content="Minimize/close to tray"
                    IsChecked="{Binding CloseToTray}"
                    Margin="0,8,0,0" />
          <CheckBox Content="Show notifications"
                    IsChecked="{Binding NotificationsEnabled}"
                    Margin="0,8,0,0" />
        </StackPanel>
      </TabItem>

      <TabItem Header="Remote Control">
        <StackPanel Margin="0,8,0,0">
          <CheckBox Content="Allow this PC to be remotely controlled"
                    IsChecked="{Binding RemoteControlEnabled}" />

          <TextBlock Text="Machine name"
                     Classes="label" />
          <TextBox Text="{Binding MachineName}"
                   PlaceholderText="Main PC" />

          <TextBlock Text="Host port"
                     Classes="label" />
          <TextBox Text="{Binding RemotePort}"
                   PlaceholderText="47632" />

          <TextBlock Text="Tailscale IP/status"
                     Classes="label" />
          <TextBlock Text="{Binding TailscaleStatus}"
                     Classes="subtle" />

          <Border Margin="0,14,0,0"
                  Padding="10"
                  CornerRadius="8"
                  Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <StackPanel>
              <TextBlock Text="Remote Command password"
                         FontWeight="SemiBold" />
              <TextBlock Text="Used only for shutdown, restart, lock, and saved actions. This is not your RustDesk password."
                         Classes="subtle"
                         Margin="0,4,0,0" />
              <TextBlock Text="{Binding PasswordStatus}"
                         Classes="subtle"
                         Margin="0,6,0,0" />
              <TextBox Text="{Binding RemoteControlPassword}"
                       PasswordChar="*"
                       PlaceholderText="New Remote Command password"
                       Margin="0,10,0,0" />
              <TextBox Text="{Binding ConfirmRemoteControlPassword}"
                       PasswordChar="*"
                       PlaceholderText="Confirm password"
                       Margin="0,8,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>

      <TabItem Header="Supabase">
        <StackPanel Margin="0,8,0,0">
          <TextBlock Text="Supabase URL"
                     Classes="label" />
          <TextBox Text="{Binding SupabaseUrl}"
                   PlaceholderText="https://YOUR_PROJECT.supabase.co" />

          <TextBlock Text="Publishable Key"
                     Classes="label" />
          <TextBox Text="{Binding PublishableKey}"
                   PlaceholderText="sb_publishable_..."
                   PasswordChar="*" />
        </StackPanel>
      </TabItem>
    </TabControl>

    <Border Grid.Row="1"
            VerticalAlignment="Bottom"
            Margin="0,0,0,2"
            Padding="10"
            CornerRadius="8"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            IsVisible="{Binding HasError}">
      <TextBlock Text="{Binding ErrorMessage}"
                 Classes="error" />
    </Border>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,16,0,0">
      <Button Content="Cancel"
              Command="{Binding CancelCommand}" />
      <Button Content="Save"
              Command="{Binding SaveCommand}" />
    </StackPanel>
  </Grid>
</Window>
