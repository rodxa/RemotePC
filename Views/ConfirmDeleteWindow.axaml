<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RemotePC.Views.ConfirmDeleteWindow"
        Title="Delete PC"
        Width="420"
        Height="190"
        MinWidth="380"
        MinHeight="180"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto" Margin="18">
    <StackPanel>
      <TextBlock Text="Delete this PC?"
                 FontSize="20"
                 FontWeight="SemiBold" />
      <TextBlock Name="MessageText"
                 Margin="0,10,0,0"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    </StackPanel>

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,16,0,0">
      <Button Content="Cancel"
              Click="OnCancelClick" />
      <Button Content="Delete"
              Click="OnDeleteClick" />
    </StackPanel>
  </Grid>
</Window>
