<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RemotePC.ViewModels"
        x:Class="RemotePC.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="RemotePC"
        Width="420"
        Height="620"
        MinWidth="360"
        MinHeight="460"
        Icon="/Assets/RPC.ico"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Border.device-card">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Ellipse.status-dot">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="{DynamicResource SystemControlDisabledBaseMediumLowBrush}" />
    </Style>
    <Style Selector="Ellipse.status-dot.online">
      <Setter Property="Fill" Value="#2FA36B" />
    </Style>
    <Style Selector="Ellipse.status-dot.offline">
      <Setter Property="Fill" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.subtle">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.help">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LineHeight" Value="17" />
    </Style>
    <Style Selector="Button.icon-button">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="18">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel>
        <TextBlock Text="Remote PCs"
                   FontSize="22"
                   FontWeight="SemiBold" />
        <TextBlock Text="{Binding Pcs.Count, StringFormat='{}{0} enabled devices'}"
                   Classes="subtle"
                   Margin="0,2,0,0" />
      </StackPanel>

      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="8">
        <Button Classes="icon-button"
                Click="OnAddDeviceClick"
                ToolTip.Tip="Add PC">
          <PathIcon Width="18"
                    Height="18"
                    Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" />
        </Button>

        <Button Classes="icon-button"
                Click="OnOpenSettingsClick"
                ToolTip.Tip="Settings">
          <PathIcon Width="18"
                    Height="18"
                    Data="M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.33 19.42,11.02L21.54,9.37L19.54,5.91L17.05,6.91C16.5,6.5 15.91,6.16 15.27,5.91L14.9,3.25H10.9L10.53,5.91C9.89,6.16 9.3,6.5 8.75,6.91L6.26,5.91L4.26,9.37L6.38,11.02C6.33,11.33 6.3,11.66 6.3,12C6.3,12.34 6.33,12.66 6.38,12.98L4.26,14.63L6.26,18.09L8.75,17.09C9.3,17.5 9.89,17.84 10.53,18.09L10.9,20.75H14.9L15.27,18.09C15.91,17.84 16.5,17.5 17.05,17.09L19.54,18.09L21.54,14.63L19.43,12.98M12.9,15.5A3.5,3.5 0,1 1,12.9,8.5A3.5,3.5 0,0 1,12.9,15.5Z" />
        </Button>

        <Button Classes="icon-button"
                Command="{Binding RefreshCommand}"
                ToolTip.Tip="Refresh PCs and status">
          <PathIcon Width="18"
                    Height="18"
                    Data="M17.65,6.35C16.2,4.9 14.21,4 12,4C7.58,4 4.01,7.58 4.01,12S7.58,20 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.82,16.33 14.6,18 12,18C8.69,18 6,15.31 6,12S8.69,6 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" />
        </Button>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1"
            Margin="0,14,0,12"
            Padding="10"
            CornerRadius="8"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            IsVisible="{Binding HasError}">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding ErrorMessage}"
                   Classes="error"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Margin="12,0,0,0"
                Content="Settings"
                IsVisible="{Binding ShowSettingsPrompt}"
                Click="OnOpenSettingsClick" />
        <TextBlock Grid.Row="1"
                   Grid.ColumnSpan="2"
                   Text="{Binding TroubleshootingText}"
                   Classes="help"
                   Margin="0,6,0,0"
                   IsVisible="{Binding HasTroubleshooting}" />
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <ProgressBar IsIndeterminate="True"
                   Height="3"
                   VerticalAlignment="Top"
                   IsVisible="{Binding IsLoading}" />

      <TextBlock Text="No enabled PCs found."
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Classes="subtle"
                 IsVisible="{Binding ShowEmptyState}" />

      <ScrollViewer Margin="0,12,0,0"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Pcs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:PcViewModel">
              <Border Classes="device-card">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Name}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DeviceName}"
                               Classes="subtle"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding HasDisplayName}" />
                  </StackPanel>

                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              Spacing="6"
                              VerticalAlignment="Top">
                    <Ellipse Classes.online="{Binding IsOnline}"
                             Classes.offline="{Binding !IsOnline}"
                             Classes="status-dot" />
                    <TextBlock Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               FontSize="12" />
                  </StackPanel>

                  <StackPanel Grid.Row="1"
                              Grid.ColumnSpan="2"
                              Margin="0,10,0,0">
                    <TextBlock Text="{Binding TailscaleIp}"
                               Classes="subtle"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding RemoteHostText}"
                               Classes="subtle"
                               Margin="0,2,0,0" />
                    <TextBlock Text="{Binding LastSeenText}"
                               Classes="subtle"
                               Margin="0,2,0,0" />
                  </StackPanel>

                  <TextBlock Grid.Row="2"
                             Grid.ColumnSpan="2"
                             Text="{Binding ErrorMessage}"
                             Classes="error"
                             Margin="0,10,0,0"
                             IsVisible="{Binding HasError}" />

                  <TextBlock Grid.Row="3"
                             Grid.ColumnSpan="2"
                             Text="{Binding TroubleshootingText}"
                             Classes="help"
                             Margin="0,8,0,0"
                             IsVisible="{Binding HasTroubleshooting}" />

                  <StackPanel Grid.Row="4"
                              Grid.ColumnSpan="2"
                              Orientation="Horizontal"
                              HorizontalAlignment="Right"
                              Spacing="8"
                              Margin="0,12,0,0">
                    <Button Classes="icon-button"
                            Click="OnEditDeviceClick"
                            ToolTip.Tip="Edit PC">
                      <PathIcon Width="17"
                                Height="17"
                                Data="M3,17.25V21H6.75L17.81,9.94L14.06,6.19L3,17.25M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04Z" />
                    </Button>

                    <Button Classes="icon-button"
                            Click="OnDeleteDeviceClick"
                            ToolTip.Tip="Delete PC">
                      <PathIcon Width="17"
                                Height="17"
                                Data="M6,19C6,20.1 6.9,21 8,21H16C17.1,21 18,20.1 18,19V7H6V19M8,9H16V19H8V9M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z" />
                    </Button>

                    <Button MinWidth="92"
                            Command="{Binding ConnectCommand}"
                            Content="{Binding ButtonText}" />
                    <Button MinWidth="92"
                            Click="OnAdvancedDeviceClick"
                            Content="Advanced" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
