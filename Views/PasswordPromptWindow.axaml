<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RemotePC.Views.PasswordPromptWindow"
        Title="Remote Command Password"
        Width="380"
        Height="180"
        MinWidth="360"
        MinHeight="170"
        CanResize="False"
        Icon="/Assets/RPC.ico"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto" Margin="18">
    <StackPanel>
      <TextBlock Name="MessageText"
                 TextWrapping="Wrap"
                 FontWeight="SemiBold" />
      <TextBox Name="PasswordBox"
               PasswordChar="*"
               PlaceholderText="Remote Command password"
               Margin="0,12,0,0" />
    </StackPanel>

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,16,0,0">
      <Button Content="Cancel"
              Click="OnCancelClick" />
      <Button Content="Run"
              Click="OnRunClick" />
    </StackPanel>
  </Grid>
</Window>
